{
  "name": "cs35l-pi",
  "version": "0.1.0",
  "description": "Pi harness with command approvals, sandboxed execution, and reusable agent tools",
  "scripts": {
    "setup:dev": "node scripts/dev.mjs setup",
    "start": "node scripts/dev.mjs start",
    "check": "node scripts/dev.mjs check",
    "doctor": "node scripts/doctor.mjs",
    "test": "node --import tsx --test tests/*.test.mjs",
    "clean:cache": "node scripts/dev.mjs clean-cache"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-only",
  "dependencies": {
    "@carderne/sandbox-runtime": "0.0.72",
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@narumitw/pi-btw": "0.61.0",
    "@narumitw/pi-goal": "0.54.8",
    "@narumitw/pi-plan-mode": "0.58.3",
    "@sinclair/typebox": "0.34.52",
    "@vscode/ripgrep": "1.18.0",
    "pi-agentsmd": "0.1.4",
    "pi-ask-user": "0.15.1",
    "pi-memory": "0.4.2",
    "pi-sandbox": "0.6.8",
    "pi-subagents": "0.71.0",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.21.0"
  },
  "pi": {
    "extensions": [
      "./extensions/harness.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
